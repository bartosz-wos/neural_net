// test_ddpm_debug.cpp — Minimal debug test for DDPM
#include <iostream>
#include "nn/layers/generative/ddpm.h"
#include "nn/core/tensor.h"

using namespace std;

int main() {
    cout << "=== DDPM Debug Test ===" << endl;

    int in_ch = 2, seq_len = 8, feat_dim = in_ch * seq_len;

    cout << "Creating DDPMModel..." << endl;
    DDPMModel model(in_ch, {8, 16, 32}, 64, seq_len, 100);
    cout << "DDPMModel created." << endl;

    Tensor x0(1, feat_dim);
    for (int j = 0; j < feat_dim; ++j)
        x0[0][j] = static_cast<float>(j % 10) * 0.1f;
    cout << "Input created: " << x0.rows << "x" << x0.cols << endl;

    // Test UNet forward directly
    cout << "Testing UNet forward directly..." << endl;
    try {
        Tensor out = model.unet().forward(x0, 50);
        cout << "UNet forward OK: " << out.rows << "x" << out.cols << endl;
    } catch (const std::exception& e) {
        cerr << "UNet forward FAILED: " << e.what() << endl;
        return 1;
    }

    cout << "All debug tests passed!" << endl;
    return 0;
}